{
  "_version": "1.60.0",
  "sap.app": {
    "id": "procurement.management",
    "type": "application",
    "title": "Procurement Management",
    "description": "SAP CAP Procurement Management",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/procurement/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.fe.templates": {},
        "sap.f": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "PurchaseOrdersList",
          "target": "PurchaseOrdersList"
        },
        {
          "pattern": "PurchaseOrders({key}):?query:",
          "name": "PurchaseOrdersObjectPage",
          "target": "PurchaseOrdersObjectPage"
        },
        {
          "pattern": "Suppliers:?query:",
          "name": "SuppliersList",
          "target": "SuppliersList"
        },
        {
          "pattern": "GoodsReceipts:?query:",
          "name": "GoodsReceiptsList",
          "target": "GoodsReceiptsList"
        },
        {
          "pattern": "Inventory:?query:",
          "name": "InventoryList",
          "target": "InventoryList"
        },
        {
          "pattern": "SupplierInvoices:?query:",
          "name": "SupplierInvoicesList",
          "target": "SupplierInvoicesList"
        }
      ],
      "targets": {
        "PurchaseOrdersList": {
          "type": "Component",
          "id": "PurchaseOrdersList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/PurchaseOrders",
              "navigation": {
                "PurchaseOrders": {
                  "detail": {
                    "route": "PurchaseOrdersObjectPage"
                  }
                }
              }
            }
          }
        },
        "PurchaseOrdersObjectPage": {
          "type": "Component",
          "id": "PurchaseOrdersObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/PurchaseOrders"
            }
          }
        },
        "SuppliersList": {
          "type": "Component",
          "id": "SuppliersList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Suppliers",
              "variantManagement": "Page"
            }
          }
        },
        "GoodsReceiptsList": {
          "type": "Component",
          "id": "GoodsReceiptsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/GoodsReceipts",
              "variantManagement": "Page"
            }
          }
        },
        "InventoryList": {
          "type": "Component",
          "id": "InventoryList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Inventory",
              "variantManagement": "Page"
            }
          }
        },
        "SupplierInvoicesList": {
          "type": "Component",
          "id": "SupplierInvoicesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/SupplierInvoices",
              "variantManagement": "Page"
            }
          }
        }
      },
      "config": {
        "routerClass": "sap.f.routing.Router"
      }
    },
    "rootView": {
      "viewName": "sap.fe.core.rootView.NavContainer",
      "type": "XML",
      "async": true,
      "id": "appRootView"
    }
  }
}
